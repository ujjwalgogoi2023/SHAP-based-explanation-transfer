# This repository holds the codebase only. Everything it produces --- the
# harmonised data, the 16 figures, the 27 result tables and the paper itself
# --- is reproducible from it by running the two commands in README.md, so
# none of it is tracked.
#
# Every directory pattern below is anchored with a leading slash. Unanchored,
# `data/` would also match `src/data/`, which is code the analysis imports.

# raw downloads and the harmonised matrices built from them
/data/
*.npz
*.parquet

# analysis output, regenerated by scripts/run_eda.py
/eda_results/

# the deliverable, built by scripts/build_report.py
/report/

# carried over from the parent deep-learning project and not used by the EDA
/paper/
/references/
/results/
/checkpoints/
*.pt
*.pth

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
~$*.docx
